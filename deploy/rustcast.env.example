# Copie para /etc/rustcast.env (chmod 600) e troque as senhas.
RUSTCAST_BIND=0.0.0.0:8000
RUSTCAST_PUBLIC_URL=https://radio.blackmesa.works
# Domínio do site que mostra o player (now playing via fetch). Sem barra no fim.
RUSTCAST_CORS_ORIGIN=https://blackmesa.works
RUSTCAST_ADMIN_PASSWORD=TROQUE-ISTO
RUSTCAST_SOURCE_PASSWORD=TROQUE-ISTO-TAMBEM
RUSTCAST_DB=/opt/rustcast/storage/rustcast.db
RUSTCAST_MEDIA_DIR=/opt/rustcast/storage/media
RUSTCAST_THREADS=2
# Fuso da grade (playlists por horário). Brasília = -180
RUSTCAST_UTC_OFFSET_MIN=-180
# Volume alvo da normalização (EBU R128). -16 = padrão de streaming; -14 mais alto
RUSTCAST_TARGET_LUFS=-16
# Pedidos de música dos ouvintes (1 liga, 0 desliga) e intervalo mínimo por IP
RUSTCAST_REQUESTS=1
RUSTCAST_REQUEST_COOLDOWN_MIN=10
